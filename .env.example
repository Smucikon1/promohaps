# Skopiuj do .env.local (lokalnie) i ustaw te same zmienne na Vercel.
# NIE commituj prawdziwych wartości — .env.local jest w .gitignore.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Anthropic (console.anthropic.com -> API Keys) — silnik odczytu gazetek i generowania przepisów
ANTHROPIC_API_KEY=sk-ant-...

# Replicate (replicate.com/account/api-tokens) — zdjęcia dań generowane przy tworzeniu
# przepisu. Bez tego klucza przepisy powstają bez zdjęcia; reszta serwisu działa normalnie.
# Model flux-schnell: ułamek grosza za zdjęcie (setki przepisów to kilka złotych).
REPLICATE_API_TOKEN=r8_...

# Adres produkcyjny (po podpięciu domeny na Vercel) — używany w sitemap/robots/OG
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl
